APP_ENV=local
APP_COMPONENT=api
AWS_REGION=ap-east-1
TABLE_NAME=life-local
ENGINE_EXECUTABLE=
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8081
ALLOWED_RETURN_URLS=http://localhost:3000/auth/callback,http://localhost:5000/auth/callback,com.cmsflash.gameoflife://auth
LOCAL_TOKEN_SECRET=replace-this-for-shared-local-development

# Production Cognito values are injected by the infrastructure stack.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_HOSTED_UI_BASE=
COGNITO_OAUTH_CALLBACK_URL=
OAUTH_STATE_SECRET=
GOOGLE_LOGIN_ENABLED=true

# Push delivery is disabled when this list is empty. Production infrastructure
# supports webPush, firebase, or both. Provider credentials stay in Secrets Manager.
PUSH_PROVIDERS=
WEB_PUSH_VAPID_PRIVATE_KEY_SECRET_ARN=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_ALLOWED_HOST_SUFFIXES=fcm.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com
FIREBASE_SERVICE_ACCOUNT_SECRET_ARN=
NOTIFICATION_FUNCTION_ARN=
NOTIFICATION_SCHEDULER_ROLE_ARN=
NOTIFICATION_SCHEDULE_GROUP_NAME=
NOTIFICATION_DEAD_LETTER_QUEUE_ARN=
